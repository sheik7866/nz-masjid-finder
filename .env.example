# NZ Masjid Finder — LOCAL TEST CREDENTIALS ONLY
#
# Copy this file to .env (same folder) and fill it in. .env is git-ignored and
# is never committed, never deployed and never shown in any report.
# Delete it when you have finished testing.
#
# Use DEDICATED test accounts, not your real admin login.

SUPABASE_URL=https://nvpmpygmtsextdmcnoiq.supabase.co
SUPABASE_ANON_KEY=

# Optional: only used to delete the rows the test creates. Leave blank if you
# would rather clean up in the Table Editor by hand.
SUPABASE_SERVICE_ROLE=

# Ordinary account: create in Authentication → Users, leave app_metadata empty.
TEST_USER_EMAIL=sheikrazil786987@gmail.com
TEST_USER_PASSWORD=

# Admin account: create in Authentication → Users, then run supabase/admin-role.sql
TEST_ADMIN_EMAIL=
